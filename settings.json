{
  "httpProxy": "http://127.0.0.1:7890",
  "lastChangelogVersion": "0.87.0",
  "theme": "dark",
  "defaultProvider": "xiaomi-token-plan-cn",
  "defaultModel": "mimo-v2.6-pro",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-web-access",
