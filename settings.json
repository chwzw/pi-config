    },
    "npm:pi-subagents"
  ],
  "tuiMode": "regular",
  "steeringMode": "all",
  "treeFilterMode": "default",
  "enableSkillCommands": true,
  "modelThinkingLevels": {
    "zai-coding-cn/glm-5.3": "max",
    "zai-coding-cn/glm-5.3-flash": "max"
  }
