+
+describe("then_run argument shim", () => {
+	it("parses a JSON-string then_run before schema validation", () => {
+		const { edit, write } = loadFusedTools();
+		const editArgs = edit.prepareArguments?.({
+			path: "x.txt",
+			edits: [{ oldText: "a", newText: "b" }],
+			then_run: '{"command":"make test","timeout":30}',
+		});
+		expect(editArgs).toMatchObject({ then_run: { command: "make test", timeout: 30 } });
+		const writeArgs = write.prepareArguments?.({
+			path: "x.txt",
+			content: "hi",
+			then_run: '{"command":"node x.js"}',
+		});
+		expect(writeArgs).toMatchObject({ then_run: { command: "node x.js" } });
+	});
+
+	it("leaves object then_run untouched and keeps unparseable strings for the validator", () => {
+		const { write } = loadFusedTools();
+		const obj = { path: "x.txt", content: "hi", then_run: { command: "ls" } };
+		expect(write.prepareArguments?.(obj)).toMatchObject({ then_run: { command: "ls" } });
+		const bad = { path: "x.txt", content: "hi", then_run: "not json" };
+		expect(write.prepareArguments?.(bad)).toMatchObject({ then_run: "not json" });
+	});
+});
