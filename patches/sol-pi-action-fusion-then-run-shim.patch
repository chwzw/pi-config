@@ -55,6 +55,27 @@ export interface ActionFusionOptions {
  * Built-in tool definitions capture their cwd in closures, so keep one per
  * working directory instead of rebuilding them on every call and every redraw.
  */
+/**
+ * Some models send nested tool arguments as JSON strings (pi's built-in edit
+ * shim unwraps `edits` the same way). Unwrap `then_run` before schema
+ * validation rejects it with "must be object".
+ */
+function withThenRunShim<TArgs>(
+	base: ((args: unknown) => TArgs) | undefined,
+): (args: unknown) => TArgs {
+	return (input) => {
+		const args = base ? base(input) : (input as TArgs);
+		if (!args || typeof args !== "object") return args;
+		const record = args as Record<string, unknown>;
+		if (typeof record.then_run === "string") {
+			try {
+				record.then_run = JSON.parse(record.then_run);
+			} catch {}
+		}
+		return args;
+	};
+}
